<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- The frame's own Wi-Fi list and joining. Android ties seeing the networks in range to
         location, since the one gives away the other; as the device owner the app grants itself
         this, because there is nobody at a frame to ask. Nothing else uses location. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- so the frame can set its own wallpaper to the splash, which is what shows
         during the few seconds of Android's placeholder home screen at boot -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <!-- Technician mode lists the installed apps so a technician can open them. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <application
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="Salah OS"
        android:theme="@style/Theme.SalahOS"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Built into the image, Salah OS outranks Frameo as the home screen, so a first boot after a
                 factory reset never asks "Select a Home app". Android ignores the priority for an app that
                 is not part of the system image. -->
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- The logo as the system wallpaper, drawn by the app because this frame's System UI is
             off and nothing else can draw one. Without it Android waits 30 s at the end of boot.
             directBootAware: Android asks for the wallpaper before the user's storage unlocks. -->
        <service
            android:name=".BootWallpaper"
            android:exported="true"
            android:directBootAware="true"
            android:label="Salah OS"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data android:name="android.service.wallpaper" android:resource="@xml/boot_wallpaper" />
        </service>

        <!-- What lets Salah OS be this frame's device owner: the standing that allows one app to
             run an appliance. Given once when the frame is prepared. -->
        <receiver
            android:name=".Admin"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data android:name="android.app.device_admin" android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- Technician mode's Back / Home / Recents bar. Enabled by the setup script; shows only while unlocked. -->
        <service
            android:name=".NavAccess"
            android:exported="true"
            android:label="@string/nav_access_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/nav_access" />
        </service>
    </application>
</manifest>
