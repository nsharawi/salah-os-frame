<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SalahOS" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:windowSplashScreenBackground">@android:color/black</item>
        <!-- The same mark, drawn right out to the edge of its canvas. Android fixes how big this
             box is, so it still cannot match the 50.6% used everywhere else, but filling the box
             makes the step up to the app's own splash far less of a jump. -->
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
    </style>
</resources>
